# Etsy Seller App credentials
# Etsy currently requires an API key on requests and OAuth 2.0 for scoped/private/write endpoints.
ETSY_API_KEY=your_keystring_colon_shared_secret
ETSY_SHOP_ID=your_numeric_shop_id
ETSY_ACCESS_TOKEN=your_oauth_access_token

# Replace each product's temporary https://www.etsy.com/ URL in lib/products.js
# with the real Etsy listing URL once listings are live.
